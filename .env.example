# --- Server -------------------------------------------------------------
# Port the web server listens on. The spec default is 8080; change it if that
# port is already taken on your machine (e.g. 8084). `npm start` (server.js)
# loads this file itself, so the value in .env is the one that actually binds.
PORT=8080
# Bind to all network interfaces so other devices on your LAN can reach it.
HOST=0.0.0.0

# --- Password protection (optional) --------------------------------------
# Set a plaintext password to lock the whole site behind a login page.
# Leave empty/unset for open access. NOTE: changing the password invalidates
# all existing sessions and requires a server restart.
# AUTH_PASSWORD=

# --- Directories --------------------------------------------------------
# Folder that contains your videos (scanned recursively). Use an absolute
# host path in production:
#   Windows:      D:\Videos
#   Linux (Nobara/postmarketOS): /home/you/Videos
VIDEO_ROOT=./media

# Where the SQLite database and generated thumbnails/previews are stored.
# IMPORTANT: keep this OUTSIDE of VIDEO_ROOT.
DATA_DIR=./data

# --- FFmpeg -------------------------------------------------------------
# Defaults to "ffmpeg"/"ffprobe" on PATH. Set absolute paths if needed, e.g.
# Windows:  FFMPEG_PATH=C:\tools\ffmpeg\bin\ffmpeg.exe
#           FFPROBE_PATH=C:\tools\ffmpeg\bin\ffprobe.exe
# Linux:    FFMPEG_PATH=/usr/bin/ffmpeg
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# --- Tuning -------------------------------------------------------------
# Periodic incremental rescan interval in milliseconds (0 disables).
RESCAN_INTERVAL_MS=300000

# Maximum number of FFmpeg encode jobs (thumbnails + previews) running at once.
GENERATOR_CONCURRENCY=2

# Preview clip length in seconds (5-8 recommended).
PREVIEW_DURATION_SEC=6
